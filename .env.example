CHRONOARB_ENV=local
CHRONOARB_AUTH_MODE=dev
# Set a unique local value with at least 32 bytes; never use development auth outside local/test.
CHRONOARB_DEV_JWT_SECRET=
CHRONOARB_JWT_ISSUER=chronoarb-dev
CHRONOARB_JWT_AUDIENCE=chronoarb-api
CHRONOARB_AUTH_TOKEN_TTL_SECONDS=900
# Comma-separated cognito_sub values explicitly allowed to act as platform operators locally.
CHRONOARB_PLATFORM_OPS_SUBJECTS=
CHRONOARB_DATABASE_URL=sqlite+aiosqlite:///chronoarb.db
CHRONOARB_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CHRONOARB_WEB_SESSION_SECRET=
