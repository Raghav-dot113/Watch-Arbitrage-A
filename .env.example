CHRONOARB_ENVIRONMENT=local
# Hackathon/demo mode: no login is required and the seeded demo user is used.
CHRONOARB_AUTH_MODE=disabled
CHRONOARB_DEMO_USER_EMAIL=owner@demo.example.com
# Set a unique local value with at least 32 bytes; never use development auth outside local/test.
CHRONOARB_DEV_JWT_SECRET=
APIMATIC_AUTH_KEY=
CHRONOARB_DATABASE_URL=sqlite+aiosqlite:///chronoarb.db
CHRONOARB_JWT_ISSUER=chronoarb-dev
CHRONOARB_JWT_AUDIENCE=chronoarb-api
CHRONOARB_AUTH_TOKEN_TTL_SECONDS=900
# Comma-separated cognito_sub values explicitly allowed to act as platform operators locally.
CHRONOARB_PLATFORM_OPS_SUBJECTS=
CHRONOARB_CORS_ORIGINS=http://localhost:3000
CHRONOARB_INTEGRATION_ENCRYPTION_KEY=
CHRONOARB_CHANNEL3_API_KEY=
# Telegram alerts: create a bot with @BotFather, then message the bot once so the
# chat exists. CHRONOARB_TELEGRAM_CHAT_ID may be a numeric chat ID or @channelname.
CHRONOARB_TELEGRAM_BOT_TOKEN=
CHRONOARB_TELEGRAM_BOT_USERNAME=
CHRONOARB_TELEGRAM_CHAT_ID=
# Public web URL used for deep links inside alert messages.
CHRONOARB_WEB_BASE_URL=http://localhost:3000
CHRONOARB_PAYPAL_CLIENT_ID=
CHRONOARB_PAYPAL_CLIENT_SECRET=
CHRONOARB_PAYPAL_WEBHOOK_ID=
CHRONOARB_PAYPAL_PLAN_IDS={}
CHRONOARB_PAYPAL_RETURN_URL=http://localhost:3000/settings/organization?checkout=success
CHRONOARB_PAYPAL_CANCEL_URL=http://localhost:3000/settings/organization?checkout=cancel
CHRONOARB_PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# Generate a random 32-byte key and base64-url encode it; retain the key for decrypting stored tokens.
# Provider calls have a bounded timeout. Queue-backed admin APIs remain unavailable until a queue adapter is configured.
CHRONOARB_PROVIDER_REQUEST_TIMEOUT_SECONDS=10
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Bryntum Business license key. apps/web/next.config.ts reads this from the repo root
# and inlines it into the client bundle, so keep the value available at build time.
NEXT_PUBLIC_BRYNTUM_LICENSE_KEY=
CHRONOARB_WEB_SESSION_SECRET=
